# SIGMA Studio — Backend .env.example
# Copie para .env e ajuste os valores.

# Segurança — DEFINA um valor forte e único em produção!
# Sem SIGMA_DEBUG=true, o servidor se recusa a subir com valores padrão.
SIGMA_JWT_SECRET=
SIGMA_JWT_ALGORITHM=HS256
SIGMA_JWT_EXPIRE_MINUTES=60
SIGMA_JWT_REFRESH_EXPIRE_DAYS=7
SIGMA_ADMIN_PASSWORD=

# App
SIGMA_APP_NAME=SIGMA Studio
SIGMA_DEBUG=true
SIGMA_DATABASE_URL=sqlite+aiosqlite:///./sigma_studio.db

# CORS
SIGMA_CORS_ORIGINS=["http://localhost:5173"]

# MQTT
SIGMA_MQTT_BROKER=localhost
SIGMA_MQTT_PORT=1883
SIGMA_MQTT_TOPIC_PREFIX=sigma

# Serial
SIGMA_SERIAL_PORT=
SIGMA_SERIAL_BAUDRATE=115200

# Google OAuth2
SIGMA_GOOGLE_CLIENT_ID=
SIGMA_GOOGLE_CLIENT_SECRET=
SIGMA_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend
SIGMA_FRONTEND_URL=http://localhost:5173
